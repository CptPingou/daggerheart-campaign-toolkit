    "rules": {
      "domain": "bone",
      "level": 5,
      "card_type": "ability",
      "recall_cost": 1
    },
    "content": {
      "rules_text": "When observing a creature, you can make an Instinct Roll \nagainst them. On a success, spend a Hope and ask the GM \nfor one set of information about the target from the following \noptions:\n ◦ Their unmarked Hit Points and Stress.\n ◦ Their Difficulty and damage thresholds.\n ◦ Their tactics and standard attack damage dice.\n ◦ Their features and Experiences.\nAdditionally on a success, you can mark a Stress to remove a \nFear from the GM’s Fear Pool.",
      "notes": null
    }
  },
