      "deprecated": false
    },
    "rules": {
      "domain": "bone",
      "level": 10,
      "card_type": "ability",
      "recall_cost": 1
    },
    "content": {
      "rules_text": "Spend 3 Hope to run a straight path through the battlefield \nto a point within Far range, making an attack against all \nadversaries within your weapon’s range along that path. \nChoose the order in which you deal damage to the targets you \nsucceeded against. For the first, roll your weapon damage with \na +1 bonus to your Proficiency. Then remove a die from your \ndamage roll and deal the remaining damage to the next target. \nContinue to remove a die for each subsequent target until you \nhave no more damage dice or adversaries. \nYou can’t target the same adversary more than once per \nattack.",
      "notes": null
    }
  },
