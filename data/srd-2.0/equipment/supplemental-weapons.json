  {
    "id": "srd-2.0.weapon.supplemental-western.secondary.1.lasso",
    "kind": "weapon",
    "slot": "secondary",
    "tier": 1,
    "name": "Lasso",
    "trait": "Agility",
    "range": "Very Close",
    "damage": "d4",
    "damage_type": "phy",
    "burden": "One-Handed",
    "feature": {
      "name": "Roped",
      "text": "On a successful attack, you can temporarily Rope the target instead of dealing damage. While Roped, the target is Restrained and Vulnerable, but you must remain within Very Close range of the target. When the target would clear this condition, you can make a Strength Reaction Roll. On a success, they remain Roped."
    },
    "source_subset": "supplemental-western",
    "source": {
      "corpus": "daggerheart-srd",
      "version": "2.0",
      "status": "srd"
    },
    "canonical": true
  },
